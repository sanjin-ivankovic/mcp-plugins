            "title": "Description"
          },
          "expires_at": {
            "title": "Expires At"
          },
          "files": {
            "additionalProperties": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Files",
            "type": "object"
          },
          "html_url": {
            "title": "Html Url"
          },
          "id": {
            "title": "Id"
          },
          "raw_urls": {
            "additionalProperties": {
