              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Gist title",
            "title": "Title"
          },
          "visibility": {
            "default": "unlisted",
            "description": "unlisted (link only), private or public",
            "enum": [
              "public",
              "unlisted",
              "private"
            ],
            "title": "Visibility",
            "type": "string"
          }
        },
        "required": [
          "files"
        ],
        "title": "opengist_create_gistArguments",
        "type": "object"
      },
