      },
      "description": "Create a gist on the homelab OpenGist and return its page URL and one raw URL per file. files maps filename to content (the extension picks the syntax highlighting). visibility defaults to unlisted, expire to 7days.",
      "inputSchema": {
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "One-line description",
            "title": "Description"
          },
          "expire": {
            "default": "7days",
            "description": "How long the gist lives",
            "enum": [
              "never",
              "1hour",
              "12hours",
              "1day",
              "7days",
              "15days"
            ],
            "title": "Expire",
            "type": "string"
          },
          "files": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Filename to content; the extension picks the highlighting",
            "title": "Files",
            "type": "object"
          },
          "title": {
