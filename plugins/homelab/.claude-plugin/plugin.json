{
  "name": "homelab",
  "version": "1.2.0",
  "description": "Read-only MCP servers for the homelab: PVE, PBS, Unraid, Technitium, Pi-hole, Komodo, Semaphore, Traefik, Alertmanager, Vault metadata and drift (custom), plus ArgoCD, Kubernetes, Longhorn, Grafana and GitLab; a SearXNG web search server; an OpenGist server with one create-gist write tool, a Docmost server that reads and writes the handbook, and a SilverBullet server that writes scratch pages for the work machine",
  "author": {
    "name": "homelab"
  },
  "license": "MIT",
  "homepage": "https://source.example.com/example-org/mcp-plugins",
  "repository": "https://source.example.com/example-org/mcp-plugins.git",
  "keywords": ["homelab", "proxmox", "kubernetes", "argocd", "grafana", "dns", "search", "mcp"],
  "mcpServers": {
    "homelab": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/run-server.sh",
        "server",
        "--config",
        "${user_config.config_file}"
      ]
    },
    "opengist": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/run-server.sh",
        "opengist",
        "--config",
        "${user_config.config_file}"
      ]
    },
    "docmost": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/run-server.sh",
        "docmost",
        "--config",
        "${user_config.config_file}"
      ]
    },
    "silverbullet": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/run-server.sh",
        "silverbullet",
        "--config",
        "${user_config.config_file}"
      ]
    },
    "searxng": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/run-server.sh",
        "searxng",
        "--config",
        "${user_config.config_file}"
      ]
    },
    "argocd": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/with-secret.sh",
        "ARGOCD_API_TOKEN=${user_config.argocd_token_file}",
        "--",
        "sh",
        "${CLAUDE_PLUGIN_ROOT}/scripts/run-node-server.sh",
        "argocd-mcp",
        "stdio"
      ],
      "env": {
        "ARGOCD_BASE_URL": "${user_config.argocd_url}",
        "MCP_READ_ONLY": "true"
      }
    },
    "kubernetes": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/run-kubernetes-mcp.sh",
        "${user_config.kubeconfig}"
      ]
    },
    "longhorn": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/run-node-server.sh",
        "longhorn-mcp",
        "--longhorn-url=${user_config.longhorn_url}",
        "--read-only"
      ]
    },
    "grafana": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/with-secret.sh",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN=${user_config.grafana_token_file}",
        "--",
        "mcp-grafana",
        "-t",
        "stdio",
        "--disable-write",
        "--disable-admin",
        "--disable-incident",
        "--disable-oncall",
        "--disable-pyroscope",
        "--disable-api",
        "--usage-stats=disabled"
      ],
      "env": {
        "GRAFANA_URL": "${user_config.grafana_url}"
      }
    },
    "gitlab": {
      "type": "http",
      "url": "${user_config.gitlab_url}/api/v4/mcp"
    }
  },
  "userConfig": {
    "config_file": {
      "type": "string",
      "title": "Config file",
      "description": "Path to the homelab-mcp config.toml (systems, URLs, secret file paths)",
      "default": "~/.config/homelab-mcp/config.toml"
    },
    "argocd_url": {
      "type": "string",
      "title": "ArgoCD URL",
      "description": "ArgoCD base URL",
      "default": "https://argo.example.com"
    },
    "argocd_token_file": {
      "type": "string",
      "title": "ArgoCD token file",
      "description": "File holding the API token of the read-only `mcp` ArgoCD account",
      "default": "~/.config/homelab-mcp/secrets/argocd"
    },
    "kubeconfig": {
      "type": "string",
      "title": "Read-only kubeconfig",
      "description": "Kubeconfig of the mcp-reader ServiceAccount (never the admin one)",
      "default": "~/.config/homelab-mcp/kubeconfig-readonly"
    },
    "longhorn_url": {
      "type": "string",
      "title": "Longhorn URL",
      "description": "Longhorn manager API base URL (the UI host proxies /v1)",
      "default": "https://longhorn.example.com"
    },
    "grafana_url": {
      "type": "string",
      "title": "Grafana URL",
      "description": "Grafana base URL for the grafana server (mcp-grafana from Homebrew)",
      "default": "https://grafana.example.com"
    },
    "grafana_token_file": {
      "type": "string",
      "title": "Grafana token file",
      "description": "File holding the token of the Viewer service account `mcp-reader` in Grafana",
      "default": "~/.config/homelab-mcp/secrets/grafana"
    },
    "gitlab_url": {
      "type": "string",
      "title": "GitLab URL",
      "description": "Self-managed GitLab base URL; its built-in MCP server lives at /api/v4/mcp",
      "default": "https://source.example.com"
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/session-check.sh"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
